# Copy this file to .env and fill in the values.

# ---- AI provider keys (server-side only — never sent to the browser) ----

# Anthropic (Claude). Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI. Get one at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=

# ---- Provider / model selection ----

# Which provider runs estimates: "openai" or "anthropic".
# If unset, it's inferred from MODEL, then from whichever key is present.
PROVIDER=openai

# Model id for the chosen provider.
#   OpenAI examples:    gpt-5.5, gpt-5-mini, gpt-4o-mini
#   Anthropic examples: claude-opus-4-7, claude-sonnet-4-6
MODEL=gpt-5.5

# Set true to skip the API entirely and return a canned TDM estimate (no key
# needed). Also used automatically when the chosen provider has no key.
USE_MOCK=false

# Port the backend listens on. Defaults to 8787.
API_PORT=8787
